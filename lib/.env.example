# Copy this file to lib/.env and fill in the values.
# WARNING: lib/.env is bundled in plain text inside the app, never put secrets here.

# http or https (default https)
HTTP_SCHEMA=https
# Public website, used by the "sign up here" link (optional)
WEBSITE_HOST=example.com
# API host, without scheme (required)
HOST=api.example.com
# API port (optional, leave empty for the scheme default)
PORT=443
# Path prefix for every API call, e.g. api/v1 (optional)
API_PREFIX=api
